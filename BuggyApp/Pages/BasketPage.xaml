<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BuggyApp.Pages.BasketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BuggyApp.ViewModels"
    x:DataType="vm:BasketViewModel"
    Title="Basket"
    Style="{StaticResource OceanPage}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,18" ColumnDefinitions="*,Auto" Style="{StaticResource OceanHeader}">
            <VerticalStackLayout>
                <Label FontAttributes="Bold" FontSize="26" Style="{StaticResource OceanHeaderTitle}" Text="Selection basket" />
                <Label Style="{StaticResource OceanHeaderText}" Text="{Binding CourseCount, StringFormat='{0} courses selected'}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Command="{Binding LoadCommand}" Text="Refresh" VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Courses}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="Your basket is empty" TextColor="{StaticResource OceanText}" />
                        <Label HorizontalTextAlignment="Center" Text="Every course can be selected once. Add courses from the catalog." TextColor="{StaticResource OceanTextMuted}" />
                        <Button Command="{Binding OpenCatalogCommand}" HorizontalOptions="Center" Text="Browse courses" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CourseItemViewModel">
                        <Border Margin="14,6" Padding="16" BackgroundColor="{StaticResource OceanSurface}" Stroke="{StaticResource OceanBorder}" StrokeShape="RoundRectangle 16">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                                <VerticalStackLayout>
                                    <Label FontAttributes="Bold" FontSize="12" Text="{Binding Code}" TextColor="{StaticResource OceanBlue}" />
                                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding Title}" TextColor="{StaticResource OceanText}" />
                                    <Label Text="{Binding Instructor}" TextColor="{StaticResource OceanTextMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" BackgroundColor="{StaticResource OceanDanger}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasketViewModel}}, Path=RemoveCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertedBoolConverter}}" Text="Remove" VerticalOptions="Center" />
                                <Button Grid.Row="1" Grid.ColumnSpan="2" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasketViewModel}}, Path=OpenDetailsCommand}" CommandParameter="{Binding .}" Text="View course details" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" Padding="16,10" BackgroundColor="{StaticResource OceanSurface}" Spacing="8">
            <Label HorizontalTextAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" Text="{Binding ErrorMessage}" TextColor="{StaticResource OceanDangerDark}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button BackgroundColor="{StaticResource OceanDanger}" Command="{Binding ClearCommand}" IsEnabled="{Binding HasCourses}" Text="Clear all" />
                <Button Grid.Column="1" BackgroundColor="{StaticResource OceanAccent}" Command="{Binding RegisterCommand}" IsEnabled="{Binding HasCourses}" Text="Register" TextColor="{StaticResource OceanNavy}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
