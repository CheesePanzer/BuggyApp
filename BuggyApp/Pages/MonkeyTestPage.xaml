<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BuggyApp.Pages.MonkeyTestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BuggyApp.ViewModels"
    x:DataType="vm:MonkeyTestViewModel"
    Title="Monkey test controls"
    Style="{StaticResource OceanPage}">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="24,26,24,22" Style="{StaticResource OceanHeader}">
            <VerticalStackLayout Spacing="5">
                <Label FontSize="12" Text="HIDDEN TEST AREA" TextColor="{StaticResource OceanMint}" />
                <Label FontAttributes="Bold" FontSize="28" Style="{StaticResource OceanHeaderTitle}" Text="Monkey test controls" />
                <Label Style="{StaticResource OceanHeaderText}" Text="Administrative controls for preparing repeatable test runs." />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Padding="12" Style="{StaticResource OceanCard}">
                        <VerticalStackLayout>
                            <Label FontAttributes="Bold" FontSize="26" Style="{StaticResource OceanHeading}" Text="{Binding CourseCount}" />
                            <Label FontSize="11" Style="{StaticResource OceanMutedText}" Text="COURSES" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12" BackgroundColor="{StaticResource OceanAccentSoft}" Stroke="{StaticResource OceanAccent}">
                        <VerticalStackLayout>
                            <Label FontAttributes="Bold" FontSize="26" Style="{StaticResource OceanHeading}" Text="{Binding BasketCount}" />
                            <Label FontSize="11" Style="{StaticResource OceanMutedText}" Text="IN BASKET" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="12" BackgroundColor="{StaticResource OceanSuccessSoft}" Stroke="{StaticResource OceanMint}">
                        <VerticalStackLayout>
                            <Label FontAttributes="Bold" FontSize="26" Style="{StaticResource OceanHeading}" Text="{Binding RegistrationCount}" />
                            <Label FontSize="11" Style="{StaticResource OceanMutedText}" Text="RECORDS" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Padding="20" Style="{StaticResource OceanCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label FontAttributes="Bold" FontSize="20" Style="{StaticResource OceanHeading}" Text="Bug configuration" />
                        <Label Style="{StaticResource OceanMutedText}" Text="Enable bug categories for the current app process. Individual bug controls are intentionally omitted." />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Command="{Binding EnableAllBugsCommand}" Text="Enable all" />
                            <Button Grid.Column="1" Command="{Binding DisableAllBugsCommand}" Text="Disable all" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                            <Label Style="{StaticResource OceanHeading}" Text="Command re-entry" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding CommandReentryEnabled}" />

                            <Label Grid.Row="1" Style="{StaticResource OceanHeading}" Text="Collection race" VerticalOptions="Center" />
                            <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding CollectionRaceEnabled}" />

                            <Label Grid.Row="2" Style="{StaticResource OceanHeading}" Text="Lifecycle" VerticalOptions="Center" />
                            <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding LifecycleEnabled}" />

                            <Label Grid.Row="3" Style="{StaticResource OceanHeading}" Text="Navigation re-entry" VerticalOptions="Center" />
                            <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding NavigationReentryEnabled}" />

                            <Label Grid.Row="4" Style="{StaticResource OceanHeading}" Text="UI thread blocking" VerticalOptions="Center" />
                            <Switch Grid.Row="4" Grid.Column="1" IsToggled="{Binding UiThreadBlockingEnabled}" />

                            <Label Grid.Row="5" Style="{StaticResource OceanHeading}" Text="State race" VerticalOptions="Center" />
                            <Switch Grid.Row="5" Grid.Column="1" IsToggled="{Binding StateRaceEnabled}" />
                        </Grid>

                        <Label FontAttributes="Bold" Style="{StaticResource OceanHeading}" Text="Trigger mode" />
                        <Picker ItemsSource="{Binding TriggerModes}" SelectedIndex="{Binding SelectedTriggerModeIndex}" />

                        <Border Padding="12" BackgroundColor="{StaticResource OceanAccentSoft}" Stroke="{StaticResource OceanAccent}">
                            <VerticalStackLayout Spacing="3">
                                <Label FontSize="11" Style="{StaticResource OceanMutedText}" Text="ENABLED SCENARIOS" />
                                <Label FontAttributes="Bold" Style="{StaticResource OceanHeading}" Text="{Binding EnabledScenariosText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Label FontSize="12" Style="{StaticResource OceanMutedText}" Text="Natural executes injected behavior. Record only logs reachability. Crash immediately throws an InjectedBugException after recording." />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20" BackgroundColor="{StaticResource OceanNavy}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <Label FontAttributes="Bold" FontSize="18" Style="{StaticResource OceanHeaderTitle}" Text="Test data controls" />
                        <Label Style="{StaticResource OceanHeaderText}" Text="Refresh the current state or reset the in-memory data before a Monkey run." />
                        <Button Command="{Binding LoadCommand}" Text="Refresh summary" />
                        <Button BackgroundColor="{StaticResource OceanDanger}" Command="{Binding ResetCommand}" Text="Reset demo data" />
                    </VerticalStackLayout>
                </Border>

                <Label IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" Style="{StaticResource OceanErrorText}" Text="{Binding ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Command="{Binding GoBackCommand}" Text="Back to dashboard" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
