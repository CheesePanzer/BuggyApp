<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BuggyApp.Pages.RegistrationResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BuggyApp.ViewModels"
    x:DataType="vm:RegistrationResultViewModel"
    Title="Registration result"
    Style="{StaticResource OceanPage}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">
                <Border Padding="24" BackgroundColor="{StaticResource OceanNavy}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="8">
                        <Border Padding="10,6" BackgroundColor="{StaticResource OceanMint}" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                            <Label FontAttributes="Bold" FontSize="12" Text="REGISTRATION COMPLETE" TextColor="{StaticResource OceanNavy}" />
                        </Border>
                        <Label FontAttributes="Bold" FontSize="32" Text="You're registered." TextColor="{StaticResource OceanOnPrimary}" />
                        <Label Text="The mocked server created a local registration record." TextColor="{StaticResource OceanMutedOnDark}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Padding="16" BackgroundColor="{StaticResource OceanSurface}" Stroke="{StaticResource OceanBorder}" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label FontSize="11" Text="REFERENCE" TextColor="{StaticResource OceanTextMuted}" />
                            <Label FontAttributes="Bold" FontSize="20" Text="{Binding RegistrationCode}" TextColor="{StaticResource OceanBlue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource OceanAccentSoft}" Stroke="{StaticResource OceanAccent}" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label FontSize="11" Text="COURSES" TextColor="{StaticResource OceanTextMuted}" />
                            <Label FontAttributes="Bold" FontSize="20" Text="{Binding CourseCount}" TextColor="{StaticResource OceanText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{Binding CreatedAtText}" TextColor="{StaticResource OceanTextMuted}" />
                <Label FontAttributes="Bold" FontSize="20" Text="Registered courses" TextColor="{StaticResource OceanText}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Courses}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CourseItemViewModel">
                            <Border Padding="14" BackgroundColor="{StaticResource OceanSurface}" Stroke="{StaticResource OceanBorder}" StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label FontAttributes="Bold" Text="{Binding Code}" TextColor="{StaticResource OceanBlue}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label FontAttributes="Bold" Text="{Binding Title}" TextColor="{StaticResource OceanText}" />
                                        <Label FontSize="12" Text="{Binding Instructor}" TextColor="{StaticResource OceanTextMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" Text="{Binding ErrorMessage}" TextColor="{StaticResource OceanDangerDark}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Padding="16,10" BackgroundColor="{StaticResource OceanSurface}" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Command="{Binding OpenCatalogCommand}" Text="Catalog" />
            <Button Grid.Column="1" Command="{Binding OpenHistoryCommand}" Text="History" />
            <Button Grid.Column="2" BackgroundColor="{StaticResource OceanAccent}" Command="{Binding OpenDetailsCommand}" Text="Details" TextColor="{StaticResource OceanNavy}" />
        </Grid>
    </Grid>
</ContentPage>
