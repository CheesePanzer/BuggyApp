<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BuggyApp.Pages.RegistrationDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BuggyApp.ViewModels"
    x:DataType="vm:RegistrationDetailViewModel"
    Title="Registration detail"
    Style="{StaticResource OceanPage}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Margin="20,20,20,10" Padding="20" BackgroundColor="{StaticResource OceanNavy}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="5">
                    <Label FontSize="11" Text="REGISTRATION REFERENCE" TextColor="{StaticResource OceanMint}" />
                    <Label FontAttributes="Bold" FontSize="28" Text="{Binding RegistrationCode}" TextColor="{StaticResource OceanOnPrimary}" />
                    <Label Text="{Binding CreatedAtText}" TextColor="{StaticResource OceanMutedOnDark}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="12,8" BackgroundColor="{StaticResource OceanAccent}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                    <Label FontAttributes="Bold" Text="{Binding CourseCount, StringFormat='{0} courses'}" TextColor="{StaticResource OceanNavy}" />
                </Border>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Courses}" SelectionMode="None">
            <CollectionView.Header>
                <Label Margin="20,10,20,8" FontAttributes="Bold" FontSize="20" Text="Courses in this registration" TextColor="{StaticResource OceanText}" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="10">
                    <Label FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" Text="Record unavailable" />
                    <Label HorizontalTextAlignment="Center" Text="It may have been removed from another page." TextColor="{StaticResource OceanTextMuted}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CourseItemViewModel">
                    <Border Margin="14,6" Padding="16" BackgroundColor="{StaticResource OceanSurface}" Stroke="{StaticResource OceanBorder}" StrokeShape="RoundRectangle 16">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <VerticalStackLayout>
                                <Label FontAttributes="Bold" FontSize="12" Text="{Binding Code}" TextColor="{StaticResource OceanBlue}" />
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Title}" TextColor="{StaticResource OceanText}" />
                                <Label Text="{Binding Instructor}" TextColor="{StaticResource OceanTextMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegistrationDetailViewModel}}, Path=OpenCourseCommand}" CommandParameter="{Binding .}" Text="Open" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Padding="16,10" BackgroundColor="{StaticResource OceanSurface}" Spacing="8">
            <Label HorizontalTextAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" Text="{Binding ErrorMessage}" TextColor="{StaticResource OceanDangerDark}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Command="{Binding GoBackCommand}" Text="Back" />
                <Button Grid.Column="1" BackgroundColor="{StaticResource OceanDanger}" Command="{Binding DeleteCommand}" IsEnabled="{Binding RecordExists}" Text="Delete record" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
